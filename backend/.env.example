# ===== Django 핵심 설정(운영 필수) =====
# 운영에서는 반드시 직접 생성한 무작위 키를 설정하세요.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# 로컬 개발에서만 true. 운영은 비우거나 false(기본값 false).
DJANGO_DEBUG=false
# 콤마로 구분한 허용 호스트. 예: v-match.example.com,www.v-match.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# (선택) 운영에서 HTTPS 리다이렉트 강제. 기본 true.
DJANGO_SSL_REDIRECT=true

# ===== V-Match AI 분석 리포트(핵심 기능) =====
# 표준 OpenAI 키만 넣으면 됩니다. (platform.openai.com 의 secret key)
# 비워두면 템플릿 폴백으로 동작합니다(데모는 안 깨짐).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# (선택) Anthropic 인라인 설명 레이어 — 안 쓰면 비워두세요(자동 폴백).
ANTHROPIC_API_KEY=

# ===== 이메일(인증코드 발송) =====
# 설정하면 SMTP 로 실제 발송, 비우면 콘솔 백엔드로 출력.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
